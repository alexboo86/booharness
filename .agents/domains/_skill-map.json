      "skills": [
        "anti-slop"
      ],
      "roles": [
        "reviewer"
      ],
      "jevAdds": true
    },
    {
      "id": "rust-async",
      "match": "\\b(tokio|async fn|spawn_blocking|JoinHandle|mpsc)\\b|\\.await\\b|\\bselect!|Arc<Mutex|(?=[\\s\\S]*(?:\\brust\\b|\\btokio\\b|\\.rs\\b))[\\s\\S]*\\bawait\\b",
