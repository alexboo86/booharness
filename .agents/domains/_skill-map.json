  "triggers": [
    {
      "id": "unknown-cause",
      "match": "\\b(bug|regression|intermittent|flaky|root cause|crash(es|ed)?)\\b|баг|почему не|не работает|сломал",
      "skills": [
        "investigate-first"
      ],
      "roles": [
        "lead",
        "coder",
        "advisor",
        "scout"
      ]
    },
    {
      "id": "diagnosing-bugs",
      "match": "\\b(bug|regression|intermittent|flaky|root cause|crash(es|ed)?|diagnos(e|is|ing)|debug(ging)?|broken|failing)\\b|баг|почему не|не работает|сломал",
      "skills": [
        "diagnosing-bugs"
      ],
      "roles": [
        "coder",
        "bughunter"
      ],
      "jevAdds": true
    },
    {
      "id": "fix",
      "match": "\\bfix(es|ed|ing)?\\b|почин|исправ",
      "skills": [
        "surgical-patch"
      ],
      "roles": [
        "lead",
        "coder"
      ],
      "jevAdds": true
    },
    {
      "id": "design-fork",
      "match": "\\b(design|architecture|trade-?offs?|which option|alternatives?)\\b|архитектур|какой вариант|развилк",
      "skills": [
        "enumerate-cases"
      ],
      "roles": [
        "lead",
        "advisor",
        "debater",
        "coder"
      ]
    },
    {
      "id": "irreversible",
      "match": "\\b(deploy|migration|migrate|drop table|purchase|rollout)\\b|деплой|выкат|миграц",
      "skills": [
        "premortem"
      ],
      "roles": [
        "lead",
        "advisor",
        "coder"
      ],
      "negatable": true
    },
    {
      "id": "contract-edit",
      "match": "\\b(AGENTS|CLAUDE)\\.md\\b",
      "skills": [
        "edit-contract-mirror"
      ],
      "roles": [
        "lead"
      ]
    },
    {
      "id": "land-worktree",
      "match": "\\bworktree\\b.*\\b(land|merge)\\b|\\b(land|merge)\\b.*\\bworktree\\b|влей|смерж",
      "skills": [
        "land-worktree"
      ],
      "roles": [
        "lead"
      ]
    },
    {
      "id": "completion",
      "match": "\\b(completion check|validation-only|prove (it|that))\\b|докажи|проверь что",
      "skills": [
        "verify-and-stop"
      ],
      "roles": [
        "lead",
        "coder",
        "reviewer",
        "bughunter"
      ],
      "jevAdds": true
    },
    {
      "id": "ui",
      "match": "\\b(ui|css|theme|panel|layout|toolbar|dialog|screen(shot)?|visual|pixel)\\b|интерфейс|панел|вкладк|экран|вёрстк|скрин",
      "skills": [
        "visual-critique",
        "desktop-interaction-review",
        "impeccable"
      ],
      "roles": [
        "lead",
        "coder",
        "reviewer",
        "bughunter"
      ]
    },
    {
      "id": "design-direction",
      "match": "\\b(redesign|re-design|visual direction|art direction|mood ?boards?|new look|look and feel)\\b|редизайн|новый (вид|облик|дизайн)|\\bdesign-direction\\b",
      "skills": [
        "design-direction",
        "impeccable",
        "visual-critique",
        "ui-ux-pro-max",
        "emil-design-eng"
      ],
      "roles": [
        "coder",
        "reviewer",
        "designer"
      ],
      "negatable": true
    },
    {
      "id": "runtime-hang",
      "match": "\\b(hang|stuck|deadlock|starv\\w*|backpressure|unbounded channel)\\b|(?<![а-яё])завис",
      "skills": [
        "tokio-runtime-diagnostics"
      ],
      "roles": [
        "lead",
        "coder",
        "scout",
        "advisor"
      ]
    },
    {
      "id": "memory-write",
      "match": "\\bmemoryctl\\b|запиши в память|хендоф",
      "skills": [
        "memoryctl"
      ],
      "roles": [
        "lead"
      ]
    },
    {
      "id": "memory-curation",
      "match": "\\b(curate|consolidate|dedup(licate)? memory|admit)\\b|почисти память",
      "skills": [
        "curate",
        "consolidate-memory",
        "admit",
        "memory-domain-extraction"
      ],
      "roles": [
        "lead"
      ]
    },
    {
      "id": "team",
      "match": "\\b(seat|scout|reviewer|coder|paseo|create_agent|delegate)\\b|скаут|тимлид|тим лид|ревьюер|агент",
      "skills": [
        "orch-team"
      ],
      "roles": [
        "lead"
      ]
    },
    {
      "id": "human-prose",
      "match": "\\b(release notes?|announcement|changelog|blog|article|postmortem)\\b|анонс|статья|пост для",
      "skills": [
        "sepia"
      ],
      "roles": [
        "lead",
        "coder"
      ]
    },
    {
      "id": "security",
      "match": "\\b(security|vulnerab\\w*|credential|capabilit(y|ies)|csp|permission scope)\\b|безопасн|уязвим",
      "skills": [
        "security-and-hardening",
        "tauri-security-checklist",
        "agent-input-safety",
        "rust-code-review"
      ],
      "roles": [
        "lead",
        "coder",
        "reviewer",
        "advisor",
        "bughunter",
        "security"
      ],
      "jevAdds": true
    },
    {
      "id": "agent-surface",
